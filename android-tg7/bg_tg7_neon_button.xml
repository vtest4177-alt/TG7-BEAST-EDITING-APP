<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC1128" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="#FF4D64" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#FF1E38"
                android:endColor="#9E0B1E" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#FF6B7E" />
        </shape>
    </item>
</selector>
